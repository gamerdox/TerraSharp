# SH-304 Environment Configuration
# Copy this file to .env and configure as needed.

# Application Settings
APP_NAME="SH-304 Hyper-Local Landslide & Flash-Flood Early Warning System"
ENVIRONMENT="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Operating Mode: 'demo' (deterministic sample datasets) or 'live' (NASA Earthdata & external APIs)
MODE="demo"

# NASA Earthdata Credentials (Required ONLY for live IMERG ingestion)
EARTHDATA_USERNAME=""
EARTHDATA_PASSWORD=""

# Default Area of Interest (AOI)
DEFAULT_AOI="wayanad"

# Analysis Grid Configuration
ANALYSIS_GRID_RESOLUTION_DEG=0.01   # Approx 1.1 km at equator

# Data Directories
DATA_RAW_DIR="data/raw"
DATA_PROCESSED_DIR="data/processed"
DATA_CACHE_DIR="data/cache"
DATA_DEMO_DIR="data/demo"

# Versioning
CONFIG_VERSION="1.0.0"
MODEL_VERSION="1.0.0"

# SMTP Emergency Email Alert Configuration (Leave blank for SIMULATED test mode)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="alerts@terrasharp.org"
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=10.0

# Alert Notification Recipients (comma-separated list of disaster management authorities)
ALERT_RECIPIENT_EMAILS="disaster-response@kerala.gov.in,district-collector@wayanad.nic.in"
ALERT_EMAIL_ENABLED=true
ALERT_COOLDOWN_SECONDS=1800.0   # 30-minute suppression between repeat warnings for same settlement
ALERT_PERSISTENCE_CYCLES=1      # Consecutive cycle confirmations required

